# ─────────────────────────────────────────────────────────────
# .env.example — คัดลอกเป็น .env.local
# โปรเจกต์นี้เป็น frontend อย่างเดียว — ไม่มี secret ของ backend (DB / JWT / Omise)
# ดู docs/API_CONTRACT.md + docs/MOCKS.md
# ─────────────────────────────────────────────────────────────

# URL ของ backend API (โปรเจกต์แยก) — ทุก request ต่อท้ายจากตรงนี้ (เช่น "/auth/login")
# ตอน dev + ใช้ mock ตั้งเป็นอะไรก็ได้ที่ไม่ว่าง
# ตอนยิง backend จริง (MOCK=0): backend เสิร์ฟ route ใต้ /api/* จริง ต้องมี /api ต่อท้าย
# backend รันที่ port 3000 (default ของมันเอง) → frontend เลยต้องรันคนละ port เช่น 3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# 1 = ใช้ MSW (backend ปลอม) ตอบแทน · 0 = ยิง backend จริงที่ NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_API_MOCK=1

# ชื่อ cookie ที่ backend ตั้งตอน login (src/lib/session.ts → SESSION_COOKIE ฝั่ง backend)
# ดีฟอลต์ในโค้ด (src/constants/auth.ts) คือ "mmc_session" ตามแผนเดิม (docs/AUTH_PLAN.md)
# แต่ backend จริงตอนนี้ใช้ "session" — เช็คให้ตรงกับ backend ที่ยิงจริงเสมอ
NEXT_PUBLIC_AUTH_COOKIE=session

# ใครกั้น /owner/* ก่อน render (src/constants/auth.ts → AUTH_GATE)
#   ไม่ตั้ง (ดีฟอลต์) = proxy.ts เช็คว่ามี cookie ข้างบนไหม — ใช้ได้เมื่อ dev บน localhost, same-origin,
#                       หรือ backend/frontend เป็น subdomain ของ site เดียวกัน (backend ตั้ง COOKIE_DOMAIN)
#   client            = proxy ไม่เช็ค cookie — ใช้เมื่อ frontend กับ backend อยู่คนละ site (cookie ของ backend
#                       frontend มองไม่เห็น ถ้าไม่ตั้งจะ login แล้ววนกลับ /login) เหลือด่านฝั่ง client ผ่าน /auth/me
# ดูตารางโครงสร้างโดเมนใน backend: docs/security-hardening.md §3 "ตั้งค่าตอน deploy"
# NEXT_PUBLIC_AUTH_GATE=client
